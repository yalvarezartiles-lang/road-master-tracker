{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hgndcsaqhnntagzmnlmr.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "autopilot-progress",
      "version": "0.1.0",
      "title": "AutoPilot Progress"
    },
    "tools": [
      {
        "name": "get_agenda",
        "title": "Consultar agenda",
        "description": "Consulta las clases de una fecha visibles para el usuario de AutoPilot Progress.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha en formato AAAA-MM-DD."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_students",
        "title": "Listar alumnos",
        "description": "Lista los alumnos visibles para el usuario de AutoPilot Progress.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 100,
              "description": "Nombre o apellido opcional para filtrar."
            },
            "includeArchived": {
              "type": "boolean",
              "description": "Incluye alumnos archivados cuando es true."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
